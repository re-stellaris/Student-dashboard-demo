<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.education.analytics.mapper.EduSkillTagMapper">

    <resultMap type="com.ruoyi.education.analytics.domain.EduSkillTag" id="EduSkillTagResult">
        <result property="skillTagId"  column="skill_tag_id" />
        <result property="code"        column="code"         />
        <result property="name"        column="name"         />
        <result property="category"    column="category"     />
        <result property="schoolAbbr"  column="school_abbr"  />
        <result property="description" column="description"  />
        <result property="keywords"    column="keywords"     />
        <result property="sortOrder"   column="sort_order"   />
        <result property="status"      column="status"       />
        <result property="courseCount" column="course_count" />
        <result property="avgScore"    column="avg_score"    />
        <result property="createTime"  column="create_time"  />
    </resultMap>

    <sql id="selectSkillTagVo">
        select skill_tag_id, code, name, category, school_abbr, description, keywords, sort_order, status, create_time
        from edu_skill_tag
    </sql>

    <select id="selectSkillTagList" parameterType="com.ruoyi.education.analytics.domain.EduSkillTag" resultMap="EduSkillTagResult">
        <include refid="selectSkillTagVo"/>
        <where>
            del_flag = '0'
            <if test="code != null and code != ''">
                and code like concat('%', #{code}, '%')
            </if>
            <if test="name != null and name != ''">
                and name like concat('%', #{name}, '%')
            </if>
            <if test="category != null and category != ''">
                and category = #{category}
            </if>
            <if test="schoolAbbr != null and schoolAbbr != ''">
                and school_abbr = #{schoolAbbr}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
            <if test="keywords != null and keywords != ''">
                and keywords like concat('%', #{keywords}, '%')
            </if>
        </where>
        order by sort_order asc, skill_tag_id asc
    </select>

    <select id="selectSkillTagById" parameterType="Long" resultMap="EduSkillTagResult">
        <include refid="selectSkillTagVo"/>
        where del_flag = '0' and skill_tag_id = #{skillTagId}
    </select>

</mapper>
