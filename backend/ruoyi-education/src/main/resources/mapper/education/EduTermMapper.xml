<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.education.enrollment.mapper.EduTermMapper">

    <resultMap type="com.ruoyi.education.enrollment.domain.EduTerm" id="EduTermResult">
        <result property="termId"       column="term_id"       />
        <result property="termCode"     column="term_code"     />
        <result property="termName"     column="term_name"     />
        <result property="academicYear" column="academic_year" />
        <result property="termIndex"    column="term_index"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"      column="end_date"      />
        <result property="isCurrent"    column="is_current"    />
        <result property="status"       column="status"        />
        <result property="createTime"   column="create_time"   />
    </resultMap>

    <sql id="selectTermVo">
        select term_id, term_code, term_name, academic_year, term_index, start_date, end_date, is_current, status, create_time
        from edu_term
    </sql>

    <select id="selectTermList" parameterType="com.ruoyi.education.enrollment.domain.EduTerm" resultMap="EduTermResult">
        <include refid="selectTermVo"/>
        <where>
            <if test="termCode != null and termCode != ''">
                and term_code like concat('%', #{termCode}, '%')
            </if>
            <if test="termName != null and termName != ''">
                and term_name like concat('%', #{termName}, '%')
            </if>
            <if test="academicYear != null and academicYear != ''">
                and academic_year = #{academicYear}
            </if>
            <if test="isCurrent != null and isCurrent != ''">
                and is_current = #{isCurrent}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by term_code desc
    </select>

    <select id="selectCurrentTerm" resultMap="EduTermResult">
        <include refid="selectTermVo"/>
        where status = '0'
        order by (is_current = '1') desc, term_code desc
        limit 1
    </select>

    <select id="selectTermByCode" parameterType="String" resultMap="EduTermResult">
        <include refid="selectTermVo"/>
        where term_code = #{termCode}
        limit 1
    </select>

    <select id="selectTermById" parameterType="Long" resultMap="EduTermResult">
        <include refid="selectTermVo"/>
        where term_id = #{termId}
    </select>

    <insert id="insertTerm" parameterType="com.ruoyi.education.enrollment.domain.EduTerm" useGeneratedKeys="true" keyProperty="termId">
        insert into edu_term (
            <if test="termCode != null and termCode != ''">term_code, </if>
            <if test="termName != null and termName != ''">term_name, </if>
            <if test="academicYear != null and academicYear != ''">academic_year, </if>
            <if test="termIndex != null">term_index, </if>
            <if test="startDate != null">start_date, </if>
            <if test="endDate != null">end_date, </if>
            <if test="isCurrent != null and isCurrent != ''">is_current, </if>
            <if test="status != null and status != ''">status, </if>
            create_time
        ) values (
            <if test="termCode != null and termCode != ''">#{termCode}, </if>
            <if test="termName != null and termName != ''">#{termName}, </if>
            <if test="academicYear != null and academicYear != ''">#{academicYear}, </if>
            <if test="termIndex != null">#{termIndex}, </if>
            <if test="startDate != null">#{startDate}, </if>
            <if test="endDate != null">#{endDate}, </if>
            <if test="isCurrent != null and isCurrent != ''">#{isCurrent}, </if>
            <if test="status != null and status != ''">#{status}, </if>
            sysdate()
        )
    </insert>

    <update id="updateTerm" parameterType="com.ruoyi.education.enrollment.domain.EduTerm">
        update edu_term
        <set>
            <if test="termCode != null and termCode != ''">term_code = #{termCode}, </if>
            <if test="termName != null and termName != ''">term_name = #{termName}, </if>
            <if test="academicYear != null">academic_year = #{academicYear}, </if>
            <if test="termIndex != null">term_index = #{termIndex}, </if>
            <if test="startDate != null">start_date = #{startDate}, </if>
            <if test="endDate != null">end_date = #{endDate}, </if>
            <if test="isCurrent != null and isCurrent != ''">is_current = #{isCurrent}, </if>
            <if test="status != null and status != ''">status = #{status}, </if>
        </set>
        where term_id = #{termId}
    </update>

    <delete id="deleteTermByIds" parameterType="Long">
        delete from edu_term where term_id in
        <foreach item="termId" collection="array" open="(" separator="," close=")">
            #{termId}
        </foreach>
    </delete>

</mapper>
