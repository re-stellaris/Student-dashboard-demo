<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.education.enrollment.mapper.EduTeacherMapper">

    <resultMap type="com.ruoyi.education.enrollment.domain.EduTeacher" id="EduTeacherResult">
        <result property="teacherId"  column="teacher_id"  />
        <result property="sysUserId"  column="sys_user_id" />
        <result property="teacherNo"  column="teacher_no"  />
        <result property="name"       column="name"        />
        <result property="deptId"     column="dept_id"     />
        <result property="school"     column="school"      />
        <result property="title"      column="title"       />
        <result property="status"     column="status"      />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectTeacherVo">
        select teacher_id, sys_user_id, teacher_no, name, dept_id, school, title, status,
               create_by, create_time, update_by, update_time
        from edu_teacher
    </sql>

    <select id="selectTeacherBySysUserId" parameterType="Long" resultMap="EduTeacherResult">
        <include refid="selectTeacherVo"/>
        where del_flag = '0' and sys_user_id = #{sysUserId}
        limit 1
    </select>

    <select id="selectTeacherById" parameterType="Long" resultMap="EduTeacherResult">
        <include refid="selectTeacherVo"/>
        where del_flag = '0' and teacher_id = #{teacherId}
    </select>

    <select id="selectTeacherByNo" parameterType="String" resultMap="EduTeacherResult">
        <include refid="selectTeacherVo"/>
        where del_flag = '0' and teacher_no = #{teacherNo}
        limit 1
    </select>

    <select id="selectTeacherList" parameterType="com.ruoyi.education.enrollment.domain.EduTeacher" resultMap="EduTeacherResult">
        <include refid="selectTeacherVo"/>
        <where>
            del_flag = '0'
            <if test="teacherNo != null and teacherNo != ''">
                and teacher_no like concat('%', #{teacherNo}, '%')
            </if>
            <if test="name != null and name != ''">
                and name like concat('%', #{name}, '%')
            </if>
            <if test="school != null and school != ''">
                and school = #{school}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by teacher_no asc
    </select>

    <insert id="insertTeacher" parameterType="com.ruoyi.education.enrollment.domain.EduTeacher" useGeneratedKeys="true" keyProperty="teacherId">
        insert into edu_teacher (
            sys_user_id,
            teacher_no,
            <if test="name != null and name != ''">name, </if>
            <if test="deptId != null">dept_id, </if>
            <if test="school != null and school != ''">school, </if>
            <if test="title != null and title != ''">title, </if>
            <if test="status != null and status != ''">status, </if>
            <if test="createBy != null and createBy != ''">create_by, </if>
            create_time
        ) values (
            #{sysUserId},
            #{teacherNo},
            <if test="name != null and name != ''">#{name}, </if>
            <if test="deptId != null">#{deptId}, </if>
            <if test="school != null and school != ''">#{school}, </if>
            <if test="title != null and title != ''">#{title}, </if>
            <if test="status != null and status != ''">#{status}, </if>
            <if test="createBy != null and createBy != ''">#{createBy}, </if>
            sysdate()
        )
    </insert>

    <update id="updateTeacher" parameterType="com.ruoyi.education.enrollment.domain.EduTeacher">
        update edu_teacher
        <set>
            <if test="sysUserId != null">sys_user_id = #{sysUserId}, </if>
            <if test="teacherNo != null and teacherNo != ''">teacher_no = #{teacherNo}, </if>
            <if test="name != null">name = #{name}, </if>
            <if test="deptId != null">dept_id = #{deptId}, </if>
            <if test="school != null">school = #{school}, </if>
            <if test="title != null">title = #{title}, </if>
            <if test="status != null and status != ''">status = #{status}, </if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy}, </if>
            update_time = sysdate()
        </set>
        where teacher_id = #{teacherId}
    </update>

</mapper>
