<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.education.curriculum.mapper.EduCurriculumMapper">

    <resultMap type="com.ruoyi.education.curriculum.domain.EduCurriculum" id="EduCurriculumResult">
        <result property="curriculumId"  column="curriculum_id"  />
        <result property="majorId"       column="major_id"       />
        <result property="versionLabel"  column="version_label"  />
        <result property="versionYear"   column="version_year"   />
        <result property="effectiveFrom" column="effective_from" />
        <result property="effectiveTo"   column="effective_to"   />
        <result property="totalCredits"  column="total_credits"  />
        <result property="majorCredits"  column="major_credits"  />
        <result property="sourceDoc"     column="source_doc"     />
        <result property="status"        column="status"         />
        <result property="delFlag"       column="del_flag"       />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectCurriculumVo">
        select curriculum_id, major_id, version_label, version_year, effective_from, effective_to,
               total_credits, major_credits, source_doc, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from edu_curriculum
    </sql>

    <select id="selectCurriculumList" parameterType="com.ruoyi.education.curriculum.dto.CurriculumQuery" resultMap="EduCurriculumResult">
        <include refid="selectCurriculumVo"/>
        <where>
            del_flag = '0'
            <if test="majorId != null">
                AND major_id = #{majorId}
            </if>
            <if test="versionYear != null">
                AND version_year = #{versionYear}
            </if>
        </where>
        order by version_year desc, curriculum_id desc
    </select>

    <select id="selectCurriculumById" parameterType="java.lang.Long" resultMap="EduCurriculumResult">
        <include refid="selectCurriculumVo"/>
        where curriculum_id = #{curriculumId} and del_flag = '0'
    </select>

    <select id="selectCurriculumByMajorAndYear" resultMap="EduCurriculumResult">
        <include refid="selectCurriculumVo"/>
        where major_id = #{majorId}
          and version_year &lt;= #{entryYear}
          and (effective_to is null or #{entryYear} &lt;= effective_to)
          and del_flag = '0'
          and (status is null or status = '0')
        order by version_year desc, curriculum_id desc
        limit 1
    </select>

    <insert id="insertCurriculum" parameterType="com.ruoyi.education.curriculum.domain.EduCurriculum" useGeneratedKeys="true" keyProperty="curriculumId">
        insert into edu_curriculum
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="majorId != null">major_id,</if>
            <if test="versionLabel != null and versionLabel != ''">version_label,</if>
            <if test="versionYear != null">version_year,</if>
            <if test="effectiveFrom != null">effective_from,</if>
            <if test="effectiveTo != null">effective_to,</if>
            <if test="totalCredits != null">total_credits,</if>
            <if test="majorCredits != null">major_credits,</if>
            <if test="sourceDoc != null">source_doc,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="majorId != null">#{majorId},</if>
            <if test="versionLabel != null and versionLabel != ''">#{versionLabel},</if>
            <if test="versionYear != null">#{versionYear},</if>
            <if test="effectiveFrom != null">#{effectiveFrom},</if>
            <if test="effectiveTo != null">#{effectiveTo},</if>
            <if test="totalCredits != null">#{totalCredits},</if>
            <if test="majorCredits != null">#{majorCredits},</if>
            <if test="sourceDoc != null">#{sourceDoc},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateCurriculum" parameterType="com.ruoyi.education.curriculum.domain.EduCurriculum">
        update edu_curriculum
        <set>
            <if test="majorId != null">major_id = #{majorId},</if>
            <if test="versionLabel != null and versionLabel != ''">version_label = #{versionLabel},</if>
            <if test="versionYear != null">version_year = #{versionYear},</if>
            <if test="effectiveFrom != null">effective_from = #{effectiveFrom},</if>
            <if test="effectiveTo != null">effective_to = #{effectiveTo},</if>
            <if test="totalCredits != null">total_credits = #{totalCredits},</if>
            <if test="majorCredits != null">major_credits = #{majorCredits},</if>
            <if test="sourceDoc != null">source_doc = #{sourceDoc},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where curriculum_id = #{curriculumId}
    </update>

    <delete id="deleteCurriculumByIds">
        delete from edu_curriculum where curriculum_id in
        <foreach item="curriculumId" collection="curriculumIds" open="(" separator="," close=")">
            #{curriculumId}
        </foreach>
    </delete>

    <select id="countCurriculumByVersion" resultType="java.lang.Integer">
        select count(1) from edu_curriculum
        where major_id = #{majorId} and version_year = #{versionYear} and del_flag = '0'
        <if test="excludeCurriculumId != null">
            and curriculum_id &lt;&gt; #{excludeCurriculumId}
        </if>
    </select>

</mapper>
