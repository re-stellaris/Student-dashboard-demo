<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.education.course.mapper.EduCourseMapper">

    <resultMap type="com.ruoyi.education.course.domain.EduCourse" id="EduCourseResult">
        <result property="courseId"       column="course_id"       />
        <result property="code"           column="code"            />
        <result property="titleZh"        column="title_zh"        />
        <result property="titleEn"        column="title_en"        />
        <result property="subject"        column="subject"         />
        <result property="courseNumber"   column="course_number"   />
        <result property="letter"         column="letter"          />
        <result property="credits"        column="credits"         />
        <result property="level"          column="level"           />
        <result property="category"       column="category"        />
        <result property="gradingBasis"   column="grading_basis"   />
        <result property="component"      column="component"       />
        <result property="campus"         column="campus"          />
        <result property="school"         column="school"          />
        <result property="academicOrg"    column="academic_org"    />
        <result property="outlineStatus"  column="outline_status"  />
        <result property="termsStatus"    column="terms_status"    />
        <result property="offeredTerms"   column="offered_terms"   />
        <result property="prereqText"     column="prereq_text"     />
        <result property="coreqText"      column="coreq_text"      />
        <result property="descriptionZh"  column="description_zh"  />
        <result property="descriptionEn"  column="description_en"  />
        <result property="status"         column="status"          />
        <result property="delFlag"        column="del_flag"        />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectCourseVo">
        select course_id, code, title_zh, title_en, subject, course_number, letter, credits, `level`, category,
               grading_basis, component, campus, school, academic_org, outline_status, terms_status, offered_terms,
               prereq_text, coreq_text, description_zh, description_en, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from edu_course
    </sql>

    <select id="selectCourseList" parameterType="com.ruoyi.education.course.dto.CourseQuery" resultMap="EduCourseResult">
        <include refid="selectCourseVo"/>
        <where>
            del_flag = '0'
            <if test="code != null and code != ''">
                AND code like concat('%', #{code}, '%')
            </if>
            <if test="title != null and title != ''">
                AND (title_zh like concat('%', #{title}, '%') or title_en like concat('%', #{title}, '%'))
            </if>
            <if test="school != null and school != ''">
                AND school = #{school}
            </if>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="level != null">
                AND `level` = #{level}
            </if>
            <if test="hasOutline != null">
                <choose>
                    <when test="hasOutline">
                        AND outline_status = 'saved_outline'
                    </when>
                    <otherwise>
                        AND (outline_status is null or outline_status &lt;&gt; 'saved_outline')
                    </otherwise>
                </choose>
            </if>
        </where>
        order by code
    </select>

    <select id="selectCourseById" parameterType="java.lang.Long" resultMap="EduCourseResult">
        <include refid="selectCourseVo"/>
        where course_id = #{courseId} and del_flag = '0'
    </select>

    <select id="selectCourseByCode" parameterType="java.lang.String" resultMap="EduCourseResult">
        <include refid="selectCourseVo"/>
        where code = #{code} and del_flag = '0'
        limit 1
    </select>

    <select id="selectCourseByCodes" resultMap="EduCourseResult">
        <include refid="selectCourseVo"/>
        where del_flag = '0' and code in
        <foreach item="code" collection="codes" open="(" separator="," close=")">
            #{code}
        </foreach>
        order by code
    </select>

    <select id="selectCourseByIds" resultMap="EduCourseResult">
        <include refid="selectCourseVo"/>
        <where>
            del_flag = '0'
            <if test="courseIds != null and courseIds.size() > 0">
                AND course_id in
                <foreach item="courseId" collection="courseIds" open="(" separator="," close=")">
                    #{courseId}
                </foreach>
            </if>
        </where>
        order by code
    </select>

    <insert id="insertCourse" parameterType="com.ruoyi.education.course.domain.EduCourse" useGeneratedKeys="true" keyProperty="courseId">
        insert into edu_course
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">code,</if>
            <if test="titleZh != null">title_zh,</if>
            <if test="titleEn != null">title_en,</if>
            <if test="subject != null">subject,</if>
            <if test="courseNumber != null">course_number,</if>
            <if test="letter != null">letter,</if>
            <if test="credits != null">credits,</if>
            <if test="level != null">`level`,</if>
            <if test="category != null">category,</if>
            <if test="gradingBasis != null">grading_basis,</if>
            <if test="component != null">component,</if>
            <if test="campus != null">campus,</if>
            <if test="school != null">school,</if>
            <if test="academicOrg != null">academic_org,</if>
            <if test="outlineStatus != null">outline_status,</if>
            <if test="termsStatus != null">terms_status,</if>
            <if test="offeredTerms != null">offered_terms,</if>
            <if test="prereqText != null">prereq_text,</if>
            <if test="coreqText != null">coreq_text,</if>
            <if test="descriptionZh != null">description_zh,</if>
            <if test="descriptionEn != null">description_en,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">#{code},</if>
            <if test="titleZh != null">#{titleZh},</if>
            <if test="titleEn != null">#{titleEn},</if>
            <if test="subject != null">#{subject},</if>
            <if test="courseNumber != null">#{courseNumber},</if>
            <if test="letter != null">#{letter},</if>
            <if test="credits != null">#{credits},</if>
            <if test="level != null">#{level},</if>
            <if test="category != null">#{category},</if>
            <if test="gradingBasis != null">#{gradingBasis},</if>
            <if test="component != null">#{component},</if>
            <if test="campus != null">#{campus},</if>
            <if test="school != null">#{school},</if>
            <if test="academicOrg != null">#{academicOrg},</if>
            <if test="outlineStatus != null">#{outlineStatus},</if>
            <if test="termsStatus != null">#{termsStatus},</if>
            <if test="offeredTerms != null">#{offeredTerms},</if>
            <if test="prereqText != null">#{prereqText},</if>
            <if test="coreqText != null">#{coreqText},</if>
            <if test="descriptionZh != null">#{descriptionZh},</if>
            <if test="descriptionEn != null">#{descriptionEn},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateCourse" parameterType="com.ruoyi.education.course.domain.EduCourse">
        update edu_course
        <set>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="titleZh != null">title_zh = #{titleZh},</if>
            <if test="titleEn != null">title_en = #{titleEn},</if>
            <if test="subject != null">subject = #{subject},</if>
            <if test="courseNumber != null">course_number = #{courseNumber},</if>
            <if test="letter != null">letter = #{letter},</if>
            <if test="credits != null">credits = #{credits},</if>
            <if test="level != null">`level` = #{level},</if>
            <if test="category != null">category = #{category},</if>
            <if test="gradingBasis != null">grading_basis = #{gradingBasis},</if>
            <if test="component != null">component = #{component},</if>
            <if test="campus != null">campus = #{campus},</if>
            <if test="school != null">school = #{school},</if>
            <if test="academicOrg != null">academic_org = #{academicOrg},</if>
            <if test="outlineStatus != null">outline_status = #{outlineStatus},</if>
            <if test="termsStatus != null">terms_status = #{termsStatus},</if>
            <if test="offeredTerms != null">offered_terms = #{offeredTerms},</if>
            <if test="prereqText != null">prereq_text = #{prereqText},</if>
            <if test="coreqText != null">coreq_text = #{coreqText},</if>
            <if test="descriptionZh != null">description_zh = #{descriptionZh},</if>
            <if test="descriptionEn != null">description_en = #{descriptionEn},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where course_id = #{courseId}
    </update>

    <delete id="deleteCourseByIds">
        delete from edu_course where course_id in
        <foreach item="courseId" collection="courseIds" open="(" separator="," close=")">
            #{courseId}
        </foreach>
    </delete>

    <select id="selectCourseOptions" resultType="com.ruoyi.education.course.domain.EduCourseOption">
        select school, category, `level`
        from edu_course
        where del_flag = '0'
        group by school, category, `level`
        order by school, category, `level`
    </select>

    <select id="countCourseByCode" parameterType="java.lang.String" resultType="java.lang.Integer">
        select count(1) from edu_course where code = #{code} and del_flag = '0'
    </select>

    <select id="selectStudentIdBySysUserId" parameterType="java.lang.Long" resultType="java.lang.Long">
        select student_id
        from edu_student
        where sys_user_id = #{sysUserId} and del_flag = '0'
        limit 1
    </select>

    <select id="selectPassedCourseIdsByStudentId" parameterType="java.lang.Long" resultType="java.lang.Long">
        select distinct r.course_id
        from edu_course_record r
        where r.student_id = #{studentId}
          and r.passed = '1'
          and r.del_flag = '0'
          and (r.record_status is null or r.record_status = 'COMPLETED')
          and r.course_id is not null
    </select>

    <select id="selectPassedCourseCodesByStudentId" parameterType="java.lang.Long" resultType="java.lang.String">
        select distinct r.course_code
        from edu_course_record r
        where r.student_id = #{studentId}
          and r.passed = '1'
          and r.del_flag = '0'
          and (r.record_status is null or r.record_status = 'COMPLETED')
          and r.course_code is not null
          and r.course_code &lt;&gt; ''
    </select>

</mapper>
