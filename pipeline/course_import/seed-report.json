    {
      "table": "edu_course",
      "column": "category",
      "default": "Major",
      "reason": "heuristic from the SIS subject prefix (ITE->IT, PED->PE, CHI/CLC->Chinese, ENG/ENL/ENB->English, GE*/GGE/GFH/GFN/BGE->GenEd, everything else->Major)"
    },
    {
      "table": "edu_course",
      "column": "credits",
      "default": "0.00",
      "reason": "SIS units that are blank or ranges such as '0.00 - 10.00'"
    },
    {
      "table": "edu_course",
      "column": "level",
      "default": "0",
      "reason": "courses whose code carries no 3-4 digit numeric part"
    },
    {
      "table": "edu_curriculum",
      "column": "total_credits",
      "default": "0.0",
      "reason": "the general/college requirement is not part of the listed inputs, so a 120-credit total cannot be derived (70 major + 48 assumed = 118)"
    },
    {
      "table": "edu_curriculum_item",
      "column": "requirement_type",
