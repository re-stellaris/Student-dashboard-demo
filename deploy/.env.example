# =====================================================================
# 若依教育平台 —— 部署环境变量模板
# ---------------------------------------------------------------------
# 用法（在 deploy/ 目录下）：
#   cp .env.example .env
#   # 然后编辑 .env，务必改掉下面三个密钥 / 口令
#   docker compose up -d --build
#
# *********************************************************************
# * 警告：DB_PASSWORD / DB_ROOT_PASSWORD / REDIS_PASSWORD / TOKEN_SECRET *
# * 是本文件里的「本地演示默认值」，只用于本机跑通。                    *
# * 任何真实部署（内网测试机 / 预发 / 生产）之前必须先改成强随机值，     *
# * 并且绝对不要把 .env 提交进 Git（.gitignore 已忽略 deploy/.env）。   *
# *********************************************************************
#
# 生成随机密钥的参考命令：
#   openssl rand -base64 32        # 口令类（去掉换行）
#   openssl rand -hex 32           # 32 字节 hex
#
# 注意：docker compose 的 .env 不支持引号内多行；值里若含 # 或空格，请用单引号包住，
#      例如 DB_PASSWORD='P@ss word#1'。
# =====================================================================

# ---------------------------------------------------------------------
# 对外访问端口（只有 frontend 会发布端口）
# ---------------------------------------------------------------------
# 宿主端口 -> 容器 80。宿主 80 被占用（IIS / 其他 nginx / 群晖等）时改成 8081 之类。
HTTP_PORT=80

# 时区（同时作用于 mysql / redis / backend / frontend 容器）
TZ=Asia/Shanghai

# ---------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------
# DB_HOST 必须是「容器网络内的主机名」，即 compose 服务名 mysql；
# 不要写 localhost / 127.0.0.1（那是指 backend 容器自己）。
DB_HOST=mysql
DB_PORT=3306
# 数据库名：与 backend/sql 初始化脚本的默认库一致（本项目统一使用 education_db）
DB_NAME=education_db
# 应用连接账号（mysql 容器首次启动时自动创建，并授予 DB_NAME 的全部权限）
# 注意：不要填 root —— 官方镜像的 MYSQL_USER 明确拒绝 root 账号。
DB_USER=ruoyi
# 【必须修改】应用账号口令
DB_PASSWORD=ruoyi_local_dev_pwd
# 【必须修改】MySQL root 口令（仅初始化脚本与备份/恢复演练使用；应用不用 root 连库）
DB_ROOT_PASSWORD=root_local_dev_pwd
# 容器内部网络不做 TLS；把 JDBC 的 useSSL 打开时设为 true（需自行提供证书）
DB_USE_SSL=false

# ---------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# 逻辑库索引（与若依默认一致）
REDIS_DB=0
# 【必须修改】Redis 口令（以 --requirepass 传入）
REDIS_PASSWORD=redis_local_dev_pwd
# 连接超时
REDIS_TIMEOUT=10s

# ---------------------------------------------------------------------
# 应用（后端）
# ---------------------------------------------------------------------
# 必须以 druid 开头、docker 在后：后加载的 profile 覆盖先加载的
SPRING_PROFILES_ACTIVE=druid,docker
# 容器内上传目录（挂载 backend_uploads 卷到 /app/data）
RUOYI_PROFILE=/app/data/uploadPath
# 【必须修改】JWT 签名密钥，建议 >= 32 位随机串。
# 未设置或为空时后端会因占位符无法解析而启动失败（刻意设计，避免弱密钥上线）。
TOKEN_SECRET=CHANGE_ME_local_dev_only_0123456789abcdef
# 令牌有效期（分钟）
TOKEN_EXPIRE_TIME=30
# JVM 参数（内存按机器实际情况调整；1G 内存的小机器建议 -Xmx768m）
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# ---------------------------------------------------------------------
# 安全基线（默认关闭，见 docs/architecture/adr/ADR-0006-security-baseline.md）
# ---------------------------------------------------------------------
# Druid 监控台：默认关闭。临时排查性能时设为 true，
# 并同时用 DRUID_LOGIN_USERNAME / DRUID_LOGIN_PASSWORD / DRUID_ALLOW 覆盖默认口令与白名单。
DRUID_STAT_VIEW_ENABLED=false
DRUID_LOGIN_USERNAME=ruoyi
DRUID_LOGIN_PASSWORD=CHANGE_ME_druid_console_pwd
DRUID_ALLOW=172.16.0.0/12
# Swagger / OpenAPI 文档：默认关闭，需要联调时设为 true
SPRINGDOC_ENABLED=false
